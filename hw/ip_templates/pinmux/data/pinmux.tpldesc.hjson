{
  template_param_list: [
    {
      name: "topname"
      desc: "Name of top-level design, e.g., 'darjeeling' or 'earlgrey'"
      type: "string"
      default: ""
    }
    {
      name: "uniquified_modules"
      desc: "A dictionary mapping template_names to uniquified_names"
      type: "object"
      default: {"clkmgr": "clkmgr1"}
    }
    {
      name: "n_wkup_detect"
      desc: "Number of wakeups"
      type: "int"
      default: "2"
    }
    {
      name: "wkup_cnt_width"
      desc: "Width of the wakeup counts"
      type: "int"
      default: "8"
    }
    {
      name: "n_mio_pads"
      desc: "Number of MIO pads"
      type: "int"
      default: "8"
    }
    {
      name: "n_mio_periph_in"
      desc: "Number of MIO periperal ins"
      type: "int"
      default: "8"
    }
    {
      name: "n_mio_periph_out"
      desc: "Number of MIO periperal outs"
      type: "int"
      default: "8"
    }
    {
      name: "mio_periph_ins"
      desc: '''
            List of {name, pads} dicts, one per MIO peripheral input, ordered ascending by the
            peripheral input index. pads lists the indices of the MIO pads the input can be muxed
            to. An entry can define the MIO_PERIPH_INSEL reset value with either default_pad (a pad
            index of pads) or default_const (0 or 1). Without, the input is tied to 0.
            '''
      type: "object"
      // The default is a full muxing for the default n_mio_pads and n_mio_periph_in.
      default: [
        {name: "periph_in_0", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_in_1", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_in_2", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_in_3", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_in_4", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_in_5", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_in_6", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_in_7", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
      ]
    }
    {
      name: "mio_periph_outs"
      desc: '''
            List of {name, pads} dicts, one per MIO peripheral output, ordered ascending by the
            peripheral output index. pads lists the indices of the MIO pads the output can be
            muxed to. An entry can select itself as the MIO_OUTSEL reset value of a pad with
            default_pad (a pad index of pads). Each pad can only be the default of one output.
            Pads without a default are high-Z.
            '''
      type: "object"
      // The default is a full muxing for the default n_mio_pads and n_mio_periph_out.
      default: [
        {name: "periph_out_0", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_out_1", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_out_2", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_out_3", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_out_4", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_out_5", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_out_6", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
        {name: "periph_out_7", pads: [0, 1, 2, 3, 4, 5, 6, 7]}
      ]
    }
    {
      name: "mio_pad_attr_resvals"
      desc: '''
            List of (name, attrs) tuples for each MIO pad, ordered ascending by the MIO pad index.
            attrs is a dict mapping given MIO_PAD_ATTR fields to non-default reset values. Fields
            not specified get the default reset value.
            '''
      type: "object"
      default: [
        ["mio_pad_0", {}], ["mio_pad_1", {}], ["mio_pad_2", {}], ["mio_pad_3", {}],
        ["mio_pad_4", {}], ["mio_pad_5", {}], ["mio_pad_6", {}], ["mio_pad_7", {}]
      ]
    }
    {
      name: "n_dio_pads"
      desc: "Number of DIO pads"
      type: "int"
      default: "8"
    }
    {
      name: "n_dio_periph_in"
      desc: "Number of DIO periperal ins"
      type: "int"
      default: "8"
    }
    {
      name: "n_dio_periph_out"
      desc: "Number of DIO periperal outs"
      type: "int"
      default: "8"
    }
    {
      name: "dio_pad_attr_resvals"
      desc: '''
            List of (name, attrs) tuples for each DIO, ordered ascending by the DIO index, which
            is the DIO_PAD_ATTR CSR index. name is the pad name, or the IO name for manual DIOs.
            attrs is a dict mapping given DIO_PAD_ATTR fields to non-default reset values. Fields
            not specified get the default reset value.
            '''
      type: "object"
      default: [
        ["dio_pad_0", {}], ["dio_pad_1", {}], ["dio_pad_2", {}], ["dio_pad_3", {}],
        ["dio_pad_4", {}], ["dio_pad_5", {}], ["dio_pad_6", {}], ["dio_pad_7", {}]
      ]
    }
    {
      name: "enable_usb_wakeup"
      desc: "Enable USB wakeup"
      type: "bool"
      default: "1"
    }
    {
      name: "enable_strap_sampling"
      desc: "Set to true to instantiate the HW strap sampling and TAP selection submodule wake submodule"
      type: "bool"
      default: "1"
    }
    {
      name: "enable_rram_tap"
      desc: '''
            Set to true to add an RRAM TAP to the TAP selection.
            The RRAM_JTAG_SEL register enables it on the TAP strap value 0, while lc_nvm_debug_en is On.
            Requires enable_strap_sampling.
            '''
      type: "bool"
      default: "0"
    }
    {
      name: "module_instance_name"
      desc: "instance name in case there are multiple pinmux instances. Not yet implemented."
      type: "string"
      default: "pinmux"
    }
  ]
}
